type tie<logic>
// tiedb/src/cli/main.tie —— tiedb 命令行入口（九命令）
// ============================================================================
// 用法：tiedb <命令> [参数]
//   fmt <file> [-w] [--compact] [--indent N] [--insertion-order] [--no-trailing]
//   check <files...>
//   to-json <file> [-o out] [-i]
//   from-json <file> [-o out] [--header] [--compact]
//   get <file> <path>
//   set <file> <path> <literal> [-w]
//   merge <base> <overlay...> [-o out]
//   compact <in.data.tie> -o <out.zd.tie>
//   decompress <in.zd.tie> -o <out.data.tie>
// 退出码：0 成功 / 1 操作失败 / 2 用法错误。
// 路径语法 v1：点分键、[n]、[-n]、["key"]、[*]。（过滤器与区间后置）
// 注意：text / code 为 tie 保留类型关键字，禁止作标识符。

import "../tdata.tie"
import "../zd.tie"
import "../codec.tie"
import "./json.tie"

// ---------- 通用工具 ----------

func usage(msg: string) -> i64 {
    print_err("用法错误: " + msg)
    print_err("运行 tiedb --help 查看帮助")
    return 2
}

func fail_msg(msg: string) -> i64 {
    print_err("错误: " + msg)
    return 1
}

func parse_or_report(path: string) -> i64 {
    var root: i64 = td.parse_file(path)
    if root < 0 {
        print_err("解析失败: " + td.last_error())
    }
    return root
}

func sub_from(s: string, start: i64, n: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        sb_append(sb, str_char(s, start + i))
        i = i + 1
    }
    return sb_build(sb)
}

// ---------- fmt ----------

func cmd_fmt(args: table<string>, n: i64) -> i64 {
    var files = table_new_string()
    var write_back: bool = false
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-w" {
            write_back = true
        } else if a == "--compact" {
            td.set_pretty(false)
        } else if a == "--insertion-order" {
            td.set_insertion(true)
        } else if a == "--no-trailing" {
            td.set_trailing(false)
        } else if a == "--indent" {
            k = k + 1
            if k >= n {
                return usage("--indent 缺少值")
            }
            var cnt_n: i64 = parse_int(args[k])
            var ind: string = ""
            var z: i64 = 0
            while z < cnt_n {
                ind = ind + " "
                z = z + 1
            }
            td.set_indent(ind)
        } else {
            table_push(files, a)
        }
        k = k + 1
    }
    if len(files) == 0 {
        return usage("fmt 至少需要一个文件")
    }
    var fi: i64 = 0
    while fi < len(files) {
        var fname: string = files[fi]
        var root: i64 = parse_or_report(fname)
        if root < 0 {
            return 1
        }
        var body: string = td.write(root)
        if write_back {
            file_write(fname, body)
            println("已写回 " + fname)
        } else {
            print(body)
        }
        fi = fi + 1
    }
    return 0
}

// ---------- check ----------

func cmd_check(args: table<string>, n: i64) -> i64 {
    if n == 0 {
        return usage("check 至少需要一个文件")
    }
    var bad: i64 = 0
    var k: i64 = 0
    while k < n {
        var fname: string = args[k]
        var root: i64 = td.parse_file(fname)
        if root < 0 {
            bad = bad + 1
            println("FAIL " + fname)
            println("  " + td.last_error())
        } else {
            println("OK   " + fname)
        }
        k = k + 1
    }
    if bad > 0 {
        return 1
    }
    return 0
}

// ---------- to-json / from-json（函数来自 json.tie；jp_src/jp_p 为 json.tie 全局） ----------

func cmd_to_json(args: table<string>, n: i64) -> i64 {
    var input: string = ""
    var output: string = ""
    var indented: bool = false
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-i" || a == "--indented" {
            indented = true
        } else if a == "-o" {
            k = k + 1
            if k >= n {
                return usage("-o 缺少值")
            }
            output = args[k]
        } else {
            input = a
        }
        k = k + 1
    }
    if str_len(input) == 0 {
        return usage("to-json 需要一个输入文件")
    }
    var root: i64 = parse_or_report(input)
    if root < 0 {
        return 1
    }
    var sb = string_builder()
    json_write_node(sb, root, 0, indented)
    sb_append(sb, "\n")
    var body: string = sb_build(sb)
    if str_len(output) > 0 {
        file_write(output, body)
        println("已写出 " + output)
    } else {
        print(body)
    }
    return 0
}

func cmd_from_json(args: table<string>, n: i64) -> i64 {
    var input: string = ""
    var output: string = ""
    var header: bool = false
    var compact: bool = false
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-o" {
            k = k + 1
            if k >= n {
                return usage("-o 缺少值")
            }
            output = args[k]
        } else if a == "--header" {
            header = true
        } else if a == "--compact" {
            compact = true
        } else {
            input = a
        }
        k = k + 1
    }
    if str_len(input) == 0 {
        return usage("from-json 需要一个输入文件")
    }
    jp_src = file_read(input)
    jp_p = 0
    jp_skip_ws()
    var root: i64 = jp_value(0)
    if root < 0 {
        return fail_msg("JSON 解析失败")
    }
    jp_skip_ws()
    if !jp_eof() {
        return fail_msg("JSON 文档末尾有多余内容")
    }
    td.set_header(header)
    td.set_pretty(!compact)
    if str_len(output) > 0 {
        td.write_file(root, output)
        println("已写出 " + output)
    } else {
        print(td.write(root))
    }
    return 0
}

// ---------- 路径引擎（键 / [n] / [-n] / ["k"] / [*]） ----------

var ps_kind: table<i64>;
var ps_key: table<string>;
var ps_idx: table<i64>;

func parse_path(path: string) -> i64 {
    ps_kind = table_new_i64()
    ps_key = table_new_string()
    ps_idx = table_new_i64()
    var n: i64 = str_len(path)
    var i: i64 = 0
    while i < n {
        var c: string = str_char(path, i)
        var cc: i64 = char_code(c)
        if cc == 46 {
            i = i + 1
            continue
        }
        if cc == 91 {
            i = i + 1
            if i >= n {
                return -1
            }
            var inner: string = str_char(path, i)
            if inner == "\"" {
                i = i + 1
                var sb = string_builder()
                var closed: bool = false
                while i < n {
                    var q: string = str_char(path, i)
                    if q == "\"" {
                        closed = true
                        i = i + 1
                        break
                    }
                    if q == "\\" && i + 1 < n {
                        sb_append(sb, str_char(path, i + 1))
                        i = i + 2
                        continue
                    }
                    sb_append(sb, q)
                    i = i + 1
                }
                if !closed || i >= n || str_char(path, i) != "]" {
                    return -1
                }
                i = i + 1
                table_push(ps_kind, 0)
                table_push(ps_key, sb_build(sb))
                table_push(ps_idx, 0)
            } else if inner == "*" {
                i = i + 1
                if i >= n || str_char(path, i) != "]" {
                    return -1
                }
                i = i + 1
                table_push(ps_kind, 2)
                table_push(ps_key, "")
                table_push(ps_idx, 0)
            } else {
                var s: i64 = i
                if str_char(path, i) == "-" {
                    i = i + 1
                }
                while i < n && char_code(str_char(path, i)) >= 48 && char_code(str_char(path, i)) <= 57 {
                    i = i + 1
                }
                if s == i || i >= n || str_char(path, i) != "]" {
                    return -1
                }
                table_push(ps_kind, 1)
                table_push(ps_key, "")
                table_push(ps_idx, parse_int(sub_from(path, s, i - s)))
                i = i + 1
            }
            continue
        }
        if cc == 42 {
            table_push(ps_kind, 2)
            table_push(ps_key, "")
            table_push(ps_idx, 0)
            i = i + 1
            continue
        }
        if cc == 93 {
            return -1
        }
        var s2: i64 = i
        while i < n {
            var d: i64 = char_code(str_char(path, i))
            if d == 46 || d == 91 || d == 93 {
                break
            }
            i = i + 1
        }
        table_push(ps_kind, 0)
        table_push(ps_key, sub_from(path, s2, i - s2))
    }
    if len(ps_kind) == 0 {
        return -1
    }
    return 0
}

// collect_seg：单段收集存活命中到 out。
func collect_seg(node: i64, kind: i64, key: string, idx: i64, out: table<i64>) {
    var t: i64 = td.ty(node)
    if kind == 0 {
        if t == 6 {
            var k: i64 = 0
            while k < td.cnt(node) {
                if td.key_at(node, k) == key && td.ty(td.ch_at(node, k)) != 0 {
                    table_push(out, td.ch_at(node, k))
                }
                k = k + 1
            }
        }
        return
    }
    if kind == 1 {
        if t != 5 {
            return
        }
        var n: i64 = td.alive_cnt(node)
        var real: i64 = idx
        if real < 0 {
            real = n + real
        }
        if real < 0 || real >= n {
            return
        }
        var seen: i64 = -1
        var j: i64 = 0
        while j < td.cnt(node) {
            if td.ty(td.ch_at(node, j)) != 0 {
                seen = seen + 1
                if seen == real {
                    table_push(out, td.ch_at(node, j))
                    return
                }
            }
            j = j + 1
        }
        return
    }
    if t == 5 || t == 6 {
        var j2: i64 = 0
        while j2 < td.cnt(node) {
            if td.ty(td.ch_at(node, j2)) != 0 {
                table_push(out, td.ch_at(node, j2))
            }
            j2 = j2 + 1
        }
    }
}

func path_get_all(root: i64, path: string) -> table<i64> {
    var empty = table_new_i64()
    if parse_path(path) < 0 {
        return empty
    }
    var current = table_new_i64()
    table_push(current, root)
    var si: i64 = 0
    while si < len(ps_kind) {
        var next = table_new_i64()
        var ci: i64 = 0
        while ci < len(current) {
            collect_seg(current[ci], ps_kind[si], ps_key[si], ps_idx[si], next)
            ci = ci + 1
        }
        if len(next) == 0 {
            return empty
        }
        current = next
        si = si + 1
    }
    return current
}

func cmd_get(args: table<string>, n: i64) -> i64 {
    if n != 2 {
        return usage("get 用法：tiedb get <file> <path>")
    }
    var root: i64 = parse_or_report(args[0])
    if root < 0 {
        return 1
    }
    var hits: table<i64> = path_get_all(root, args[1])
    if len(hits) == 0 {
        print_err("路径无命中: " + args[1])
        return 1
    }
    println(td.write(hits[0]))
    return 0
}

// nav_step：沿段导航；缺失时自动建容器（下一段为索引→数组，否则表）。
// 仅支持正索引越界追加（pos==alive）；负索引越界与中间空洞报错。
func nav_step(node: i64, kind: i64, key: string, idx: i64, alive: i64, next_is_index: bool) -> i64 {
    if kind == 0 {
        var k: i64 = 0
        while k < td.cnt(node) {
            if td.key_at(node, k) == key && td.ty(td.ch_at(node, k)) != 0 {
                return td.ch_at(node, k)
            }
            k = k + 1
        }
        if next_is_index {
            var na: i64 = td.new_array()
            td.push_child(node, key, na)
            return na
        }
        var nm: i64 = td.new_map()
        td.push_child(node, key, nm)
        return nm
    }
    if idx >= 0 && idx < alive {
        var seen: i64 = -1
        var j: i64 = 0
        while j < td.cnt(node) {
            if td.ty(td.ch_at(node, j)) != 0 {
                seen = seen + 1
                if seen == idx {
                    return td.ch_at(node, j)
                }
            }
            j = j + 1
        }
        return -1
    }
    if idx == alive {
        var fresh: i64 = td.new_array()
        td.push_child(node, "", fresh)
        return fresh
    }
    return -1
}

func cmd_set(args: table<string>, n: i64) -> i64 {
    var write_back: bool = false
    var rest = table_new_string()
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-w" {
            write_back = true
        } else {
            table_push(rest, a)
        }
        k = k + 1
    }
    if len(rest) != 3 {
        return usage("set 用法：tiedb set <file> <path> <tie字面量> [-w]")
    }
    var root: i64 = parse_or_report(rest[0])
    if root < 0 {
        return 1
    }
    if parse_path(rest[1]) < 0 {
        return usage("路径非法: " + rest[1])
    }
    var val_root: i64 = td.parse(rest[2])
    if val_root < 0 {
        return fail_msg("值字面量解析失败: " + td.last_error())
    }
    var node: i64 = root
    var si: i64 = 0
    var segs: i64 = len(ps_kind)
    while si < segs - 1 {
        var alive_now: i64 = td.alive_cnt(node)
        node = nav_step(node, ps_kind[si], ps_key[si], ps_idx[si], alive_now,
            ps_kind[si + 1] == 1)
        if node < 0 {
            return fail_msg("导航失败于段 " + to_string(si) + "（越界索引不支持自动扩容）")
        }
        si = si + 1
    }
    var lk: i64 = segs - 1
    var lkind: i64 = ps_kind[lk]
    var lkey: string = ps_key[lk]
    var lidx: i64 = ps_idx[lk]
    if lkind == 0 {
        var dup: i64 = -1
        var kk: i64 = 0
        while kk < td.cnt(node) {
            if td.key_at(node, kk) == lkey && td.ty(td.ch_at(node, kk)) != 0 {
                dup = kk
            }
            kk = kk + 1
        }
        if dup >= 0 {
            td.replace_child(node, dup, val_root)
        } else {
            td.push_child(node, lkey, val_root)
        }
    } else {
        var alive_v: i64 = td.alive_cnt(node)
        var pos: i64 = lidx
        if pos < 0 {
            pos = alive_v + pos
        }
        if pos >= 0 && pos < alive_v {
            var seen: i64 = -1
            var j: i64 = 0
            while j < td.cnt(node) {
                if td.ty(td.ch_at(node, j)) != 0 {
                    seen = seen + 1
                    if seen == pos {
                        td.replace_child(node, j, val_root)
                    }
                }
                j = j + 1
            }
        } else if pos == alive_v {
            td.push_child(node, "", val_root)
        } else {
            return fail_msg("索引越界且非尾部追加（v0.1 不支持空洞填充）")
        }
    }
    if write_back {
        td.write_file(root, rest[0])
        println("已写回 " + rest[0])
    } else {
        print(td.write(root))
    }
    return 0
}

// ---------- merge（官方 L2 深合并） ----------

func merge_nodes(a: i64, b: i64) -> i64 {
    if td.ty(a) == 6 && td.ty(b) == 6 {
        var out: i64 = td.clone(a)
        var k: i64 = 0
        while k < td.cnt(b) {
            var bval: i64 = td.ch_at(b, k)
            if td.ty(bval) == 0 {
                k = k + 1
                continue
            }
            var bkey: string = td.key_at(b, k)
            var base_hit: i64 = -1
            var j: i64 = 0
            while j < td.cnt(out) {
                if td.key_at(out, j) == bkey && td.ty(td.ch_at(out, j)) != 0 {
                    base_hit = j
                }
                j = j + 1
            }
            var merged_child: i64 = td.clone(bval)
            if base_hit >= 0 {
                var aval: i64 = td.ch_at(out, base_hit)
                var reset: bool = td.ty(aval) == 5 && td.ty(bval) == 4 && td.txt(bval) == "="
                if reset {
                    merged_child = td.new_array()
                } else if td.ty(aval) == 6 && td.ty(bval) == 6 {
                    merged_child = merge_nodes(aval, bval)
                } else if td.ty(aval) == 5 && td.ty(bval) == 5 {
                    merged_child = concat_arrays(aval, bval)
                }
                td.replace_child(out, base_hit, merged_child)
            } else {
                td.push_child(out, bkey, merged_child)
            }
            k = k + 1
        }
        return out
    }
    if td.ty(a) == 5 && td.ty(b) == 5 {
        return concat_arrays(a, b)
    }
    return td.clone(b)
}

func concat_arrays(a: i64, b: i64) -> i64 {
    var out: i64 = td.clone(a)
    var k: i64 = 0
    while k < td.cnt(b) {
        if td.ty(td.ch_at(b, k)) != 0 {
            td.push_child(out, "", td.clone(td.ch_at(b, k)))
        }
        k = k + 1
    }
    return out
}

func cmd_merge(args: table<string>, n: i64) -> i64 {
    var files = table_new_string()
    var output: string = ""
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-o" {
            k = k + 1
            if k >= n {
                return usage("-o 缺少值")
            }
            output = args[k]
        } else {
            table_push(files, a)
        }
        k = k + 1
    }
    if len(files) < 2 {
        return usage("merge 至少需要两层：<base> <overlay> [-o out]")
    }
    var acc: i64 = parse_or_report(files[0])
    if acc < 0 {
        return 1
    }
    var fi: i64 = 1
    while fi < len(files) {
        var layer: i64 = parse_or_report(files[fi])
        if layer < 0 {
            return 1
        }
        acc = merge_nodes(acc, layer)
        fi = fi + 1
    }
    if str_len(output) > 0 {
        td.write_file(acc, output)
        println("已写出 " + output)
    } else {
        print(td.write(acc))
    }
    return 0
}

// ---------- compact / decompress（tie:data ↔ tie:zd） ----------

func cmd_compact(args: table<string>, n: i64) -> i64 {
    var input: string = ""
    var output: string = ""
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-o" {
            k = k + 1
            if k >= n {
                return usage("-o 缺少值")
            }
            output = args[k]
        } else {
            input = a
        }
        k = k + 1
    }
    if str_len(input) == 0 || str_len(output) == 0 {
        return usage("compact 用法：tiedb compact <in.data.tie> -o <out.zd.tie>")
    }
    var root: i64 = parse_or_report(input)
    if root < 0 {
        return 1
    }
    var bytes: table<i64> = tdc.encode_node(root)
    if zd.save(output, bytes) {
        println("已压缩 " + output + "（" + to_string(len(bytes)) + " 字节负载）")
        return 0
    }
    return fail_msg("写入失败")
}

func cmd_decompress(args: table<string>, n: i64) -> i64 {
    var input: string = ""
    var output: string = ""
    var k: i64 = 0
    while k < n {
        var a: string = args[k]
        if a == "-o" {
            k = k + 1
            if k >= n {
                return usage("-o 缺少值")
            }
            output = args[k]
        } else {
            input = a
        }
        k = k + 1
    }
    if str_len(input) == 0 || str_len(output) == 0 {
        return usage("decompress 用法：tiedb decompress <in.zd.tie> -o <out.data.tie>")
    }
    var bytes: table<i64> = zd.load(input)
    if len(bytes) == 0 {
        return fail_msg("非 zd 文件或空文件")
    }
    var (root, np) = tdc.decode_value(bytes, 0)
    if np < 0 {
        return fail_msg("zd 解码错误")
    }
    td.set_header(true)
    td.write_file(root, output)
    println("已解压 " + output)
    return 0
}

// ---------- 帮助与分发 ----------

func print_help() {
    println("tiedb v0.3-fmt2 — tie:data / tie:zd 数据服务 CLI")
    println("")
    println("用法: tiedb <命令> [参数]")
    println("")
    println("命令:")
    println("  fmt <file> [-w] [--compact] [--indent N] [--insertion-order] [--no-trailing]")
    println("  check <files...>")
    println("  to-json <file> [-o out] [-i]")
    println("  from-json <file> [-o out] [--header] [--compact]")
    println("  get <file> <path>")
    println("  set <file> <path> <literal> [-w]")
    println("  merge <base> <overlay...> [-o out]")
    println("  compact <in.data.tie> -o <out.zd.tie>")
    println("  decompress <in.zd.tie> -o <out.data.tie>")
    println("")
    println("路径语法: 点分键、[n]、[-n]、[\"key\"]、[*]；示例 tiec.features[0] 或 servers[?].name")
    println("")
    println("退出码: 0 成功 / 1 操作失败 / 2 用法错误")
}

func main() {
    var total: i64 = arg_count()
    if total == 0 {
        print_help()
        exit(2)
        return
    }
    var cmd_name: string = arg_string(0)
    if cmd_name == "--help" || cmd_name == "-h" {
        print_help()
        exit(0)
        return
    }
    var rest = table_new_string()
    var i: i64 = 1
    while i < total {
        table_push(rest, arg_string(i))
        i = i + 1
    }
    var argc: i64 = len(rest)
    var status: i64 = 2
    if cmd_name == "fmt" {
        status = cmd_fmt(rest, argc)
    } else if cmd_name == "check" {
        status = cmd_check(rest, argc)
    } else if cmd_name == "to-json" {
        status = cmd_to_json(rest, argc)
    } else if cmd_name == "from-json" {
        status = cmd_from_json(rest, argc)
    } else if cmd_name == "get" {
        status = cmd_get(rest, argc)
    } else if cmd_name == "set" {
        status = cmd_set(rest, argc)
    } else if cmd_name == "merge" {
        status = cmd_merge(rest, argc)
    } else if cmd_name == "compact" {
        status = cmd_compact(rest, argc)
    } else if cmd_name == "decompress" {
        status = cmd_decompress(rest, argc)
    } else {
        status = usage("未知命令 \"" + cmd_name + "\"")
    }
    exit(status)
}
