type tie<logic>
// probe: arg parsing + parse/write 测试
import "../src/tdata.tie"
import "../src/zd.tie"
import "../src/codec.tie"
import "../src/cli/json.tie"

func main() {
    // mimic main.tie arg parsing
    var total: i64 = arg_count()
    println("argc=" + to_string(total))
    var cmd_name: string = arg_string(0)
    println("cmd=" + cmd_name)
    var rest = table_new_string()
    var i: i64 = 1
    while i < total {
        table_push(rest, arg_string(i))
        i = i + 1
    }
    println("rest_len=" + to_string(len(rest)))
    // actual parse + write
    println("parse start")
    var root: i64 = td.parse("[\"name\": \"hello\", \"val\": 42]")
    println("alive=" + to_string(td.alive_cnt(root)))
    println("write start")
    var out: string = td.write(root)
    println("out=" + out)
    // second parse
    println("parse2 start")
    var root2: i64 = td.parse("[\"b\": 2]")
    println("write2=" + td.write(root2))
}
