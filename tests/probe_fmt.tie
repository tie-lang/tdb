type tie<logic>
// probe_fmt: 模拟 cmd_fmt 精确路径
import "../src/tdata.tie"
import "../src/zd.tie"
import "../src/codec.tie"
import "../src/cli/json.tie"

func parse_or_report(path: string) -> i64 {
    var root: i64 = td.parse_file(path)
    if root < 0 {
        print_err("parse fail: " + td.last_error())
    }
    return root
}

func cmd_fmt_one(fname: string) -> i64 {
    var root: i64 = parse_or_report(fname)
    if root < 0 {
        return 1
    }
    println("alive=" + to_string(td.alive_cnt(root)))
    var body: string = td.write(root)
    println("body=" + body)
    return 0
}

func main() {
    var total: i64 = arg_count()
    println("argc=" + to_string(total))
    var i: i64 = 1
    while i < total {
        var fname: string = arg_string(i)
        println("file=" + fname)
        var s: i64 = cmd_fmt_one(fname)
        println("result=" + to_string(s))
        i = i + 1
    }
}
