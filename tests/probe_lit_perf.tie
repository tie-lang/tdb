type tie<logic>
// probe_lit_perf：表字面量构造吞吐（r.1.6.7 批量 codegen 的收益基准）
// 64 元素字面量，元素依赖循环变量 r（每次都需重新构造，无法被 LLVM 提升）。
// 用法：probe_lit_perf <rep>；外部计时（差值法）。
var g_acc: i64 = 0

func main() {
    var rep: i64 = 1000
    if arg_count() > 0 {
        rep = parse_int(arg_string(0))
    }
    var r: i64 = 0
    while r < rep {
        var t = [r + 0, r + 1, r + 2, r + 3, r + 4, r + 5, r + 6, r + 7, r + 8, r + 9, r + 10, r + 11, r + 12, r + 13, r + 14, r + 15, r + 16, r + 17, r + 18, r + 19, r + 20, r + 21, r + 22, r + 23, r + 24, r + 25, r + 26, r + 27, r + 28, r + 29, r + 30, r + 31, r + 32, r + 33, r + 34, r + 35, r + 36, r + 37, r + 38, r + 39, r + 40, r + 41, r + 42, r + 43, r + 44, r + 45, r + 46, r + 47, r + 48, r + 49, r + 50, r + 51, r + 52, r + 53, r + 54, r + 55, r + 56, r + 57, r + 58, r + 59, r + 60, r + 61, r + 62, r + 63]
        g_acc = g_acc + t[0] + t[63]
        r = r + 1
    }
    println("sink=" + to_string(g_acc))
}
