type tie<logic>
// probe_zd_v3: zd v3 骨架面（头 / 索引 footer / 段表 / 多段文档 / 读义务 / 一致性门）
// ---------------------------------------------------------------------------
// 对齐权威实现 zd-java（tie-lang/zd-java）。覆盖：
//   1. 头：10 字节、版本 base-48 "03"、flags 低 7 位掩码
//   2. 读义务：v2/v3 都接受；v1 头可识别但不在 v2+v3 读义务内
//   3. 索引 footer：25 字节、crc32 覆盖索引段、坏 crc 拒绝
//   4. 段表：编码/解码往返；自定义段名必填；负偏移/长度拒绝
//   5. 多段文档：assemble/read 往返、**按类型查找不假设段序**、flags 自动置位
//   6. 一致性门：非 v3 / bit5 未置 / crc 不符 / 段越界 → 确定性拒绝
//   7. 文件往返：save_v3 / load_v3
//   8. **schema 段**：schema_id（tsha1f n=48）+ 三态纪律 + 演进前置条件
//      + **跨语言 KAT**（schema 段逐字节 == zd-java ZdSchema.encodeSegment）
//   9. **标准类型三件**：timestamp(1) / decimal(2) / uuid(3)，含跨语言 KAT 与越界拒绝
//  10. **图容器紧凑形态**：声明位 / 节点表 / 边表 / 约束双侧校验 / 跨语言 KAT
import "../src/zd.tie"
import "../src/zd_ext.tie"
import "../src/zd_v3.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

// mkbytes：n 字节（值 0..255 循环）。
func mkbytes(n: i64) -> table<i64> {
    var t = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(t, i & 0xFF)
        i = i + 1
    }
    return t
}

// mkstrs：字面量字符串表，避免逐元素 push 的开销差异影响断言。
// 段表用名：第 0 项给数据段（可空）、第 1 项给列式段、第 2 项给**自定义段**
// （类型 6 名必填，故此处必须非空）。
func mkstrs() -> table<string> {
    var t = table_new_string()
    table_push(t, "")
    table_push(t, "meta")
    table_push(t, "custom")
    return t
}

func main() {
    var work: string = arg_string(0)
    if str_len(work) == 0 {
        work = "/tmp/zdv3probe"
    }

    // ---------- 1. 头 ----------
    var h = zd_v3.make_header_v3(0)
    check(len(h) == 10, "头长度 10 字节")
    check(zd_v3.header_version(h) == 3, "头版本 = 3（base-48 \"03\"）")
    check(zd_v3.is_v3(h), "is_v3 判据")
    var h2 = zd_v3.make_header_v3(0xFF)
    check(zd_v3.header_flags(h2) == 0x7F, "flags 掩码取低 7 位（0xFF → 0x7F）")
    check(h[0] == 0x54 && h[6] == 0x44, "魔数 TIEDBZD")
    check(h[7] == 0x00 && h[8] == 0x03, "版本两位 = 0x00 0x03")

    // ---------- 2. 读义务（v2/v3 都接受；v1 可识别但不在义务内） ----------
    var hdr_v2: table<i64> = [0x54, 0x49, 0x45, 0x44, 0x42, 0x5A, 0x44, 0x00, 0x02, 0x00]
    var hdr_v1: table<i64> = [0x54, 0x49, 0x45, 0x44, 0x42, 0x5A, 0x44, 0x01]
    var hdr_bad: table<i64> = [0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47, 0x00, 0x03, 0x00]
    check(zd_v3.header_version(hdr_v2) == 2, "v2 头识别为版本 2")
    check(zd_v3.header_version(hdr_v1) == 1, "v1 头（8 字节）识别为版本 1")
    check(zd_v3.header_version(hdr_bad) == -1, "非法魔数 → -1")
    check(zd_v3.accept_v2_or_v3(hdr_v2) && zd_v3.accept_v2_or_v3(h),
        "读义务 = v2 + v3（两者都接受）")
    check(!zd_v3.accept_v2_or_v3(hdr_v1), "v1 头不在 v2+v3 读义务内")
    check(!zd_v3.is_v3(hdr_v2), "v2 头不是 v3")

    // ---------- 3. 索引 footer ----------
    var idx_payload = mkbytes(20)
    var foot = zd_v3.footer_write(100, idx_payload)
    check(len(foot) == 25, "footer 长度 25 字节")
    check(foot[0] == 0x5A && foot[4] == 0x54, "footer 魔数 ZD3FT")
    // 组装一个文件再探测
    var types1 = table_new_i64()
    var names1 = table_new_string()
    var blob1 = mkbytes(30)
    var soffs1 = table_new_i64()
    var slens1 = table_new_i64()
    table_push(types1, 0)
    table_push(soffs1, 0)
    table_push(slens1, 30)
    table_push(names1, "")
    var doc = zd_v3.assemble(0, types1, blob1, soffs1, slens1, names1)
    check(len(doc) > 0, "assemble 单段文档非空")
    var (has, ioff, ilen, icrc) = zd_v3.footer_probe(doc)
    check(has, "footer_probe 命中魔数")
    check(ioff == 10 + 30, "index_off = 10(头) + 30(段载荷) = 40")
    check(ilen > 0, "index_len > 0")
    var idx_bytes = zd.slice(doc, ioff, ioff + ilen)
    check(zd_v3.footer_crc_ok(idx_bytes, icrc), "footer crc32 与索引段一致")
    check(!zd_v3.footer_crc_ok(idx_bytes, icrc + 1), "crc 不符 → 拒绝")

    // ---------- 4. 段表编码/解码往返 ----------
    var tys = table_new_i64()
    var offs = table_new_i64()
    var lens = table_new_i64()
    var nms = mkstrs()
    table_push(tys, 0)
    table_push(offs, 10)
    table_push(lens, 100)
    table_push(tys, 2)
    table_push(offs, 110)
    table_push(lens, 200)
    table_push(tys, 6)
    table_push(offs, 310)
    table_push(lens, 5)
    // 注意：类型 6（自定义段）**名称必填**——mkstrs() 的第 2 项须为非空
    var enc_idx = zd_v3.encode_index(tys, offs, lens, nms)
    check(len(enc_idx) > 0, "段表编码非空")
    var (dtys, doffs, dlens, dnms, dnext) = zd_v3.decode_index(enc_idx, 0)
    check(dnext == len(enc_idx), "段表解码消费全部字节")
    check(len(dtys) == 3, "段表解码 3 段")
    check(dtys[0] == 0 && dtys[2] == 6, "段类型往返")
    check(doffs[1] == 110 && dlens[1] == 200, "偏移/长度往返")
    check(dnms[1] == "meta", "段名往返")

    // 自定义段名必填（类型 6 + 空名 → 拒绝）
    var bad_tys = table_new_i64()
    var bad_offs = table_new_i64()
    var bad_lens = table_new_i64()
    var bad_nms = table_new_string()
    table_push(bad_tys, 6)
    table_push(bad_offs, 10)
    table_push(bad_lens, 1)
    table_push(bad_nms, "")
    check(len(zd_v3.encode_index(bad_tys, bad_offs, bad_lens, bad_nms)) == 0,
        "自定义段（类型 6）名称必填 → 空名拒绝")
    // 负偏移拒绝
    var neg_offs = table_new_i64()
    table_push(neg_offs, 0 - 1)
    check(len(zd_v3.encode_index(tys, neg_offs, lens, nms)) == 0, "负偏移拒绝")

    // ---------- 5. 多段文档往返 + 段序无关 + flags 自动置位 ----------
    var t5 = table_new_i64()
    var n5 = table_new_string()
    var o5 = table_new_i64()
    var l5 = table_new_i64()
    var a5 = mkbytes(11)
    var b5 = mkbytes(22)
    var c5 = mkbytes(33)
    var d5 = mkbytes(44)
    // blob = 四段顺序拼接（首段相对偏移 0，首尾相接）
    var blob5 = zd.concat(a5, zd.concat(b5, zd.concat(c5, d5)))
    table_push(t5, 0)
    table_push(o5, 0)
    table_push(l5, 11)
    table_push(n5, "")
    table_push(t5, 1)
    table_push(o5, 11)
    table_push(l5, 22)
    table_push(n5, "")
    table_push(t5, 4)
    table_push(o5, 33)
    table_push(l5, 33)
    table_push(n5, "")
    table_push(t5, 3)
    table_push(o5, 66)
    table_push(l5, 44)
    table_push(n5, "")
    var doc5 = zd_v3.assemble(zd_v3.flag_stream(), t5, blob5, o5, l5, n5)
    check(len(doc5) > 0, "assemble 四段文档非空")
    var f5 = zd_v3.header_flags(doc5)
    check((f5 & zd_v3.flag_index()) != 0, "bit5 索引 footer 恒置")
    check((f5 & zd_v3.flag_dictionary()) != 0, "含字符串池段 → bit0 自动置位")
    check((f5 & zd_v3.flag_graph()) != 0, "含图段 → bit6 自动置位")
    check((f5 & zd_v3.flag_stream()) != 0, "调用方 flags（bit3 流式）并入")
    check((f5 & zd_v3.flag_columnar()) == 0, "无列式段 → bit1 不置位")

    var (ok5, rt5, ro5, rl5, rn5) = zd_v3.read_index(doc5)
    check(ok5, "read_index 一致 → ok")
    check(len(rt5) == 4, "读回 4 段表项")
    // **按类型查找（不假设段序）**
    var i_data = zd_v3.find_segment(rt5, rn5, 0, "")
    var i_pool = zd_v3.find_segment(rt5, rn5, 1, "")
    var i_graph = zd_v3.find_segment(rt5, rn5, 4, "")
    var i_sch = zd_v3.find_segment(rt5, rn5, 3, "")
    check(i_data >= 0 && i_pool >= 0 && i_graph >= 0 && i_sch >= 0, "四段类型均可定位")
    var sdata = zd_v3.segment_bytes(doc5, ro5, rl5, i_data)
    var spool = zd_v3.segment_bytes(doc5, ro5, rl5, i_pool)
    var sgraph = zd_v3.segment_bytes(doc5, ro5, rl5, i_graph)
    var ssch = zd_v3.segment_bytes(doc5, ro5, rl5, i_sch)
    check(len(sdata) == 11 && len(spool) == 22 &&
          len(sgraph) == 33 && len(ssch) == 44, "各段载荷长度正确（按类型定位）")
    check(sdata[3] == 3 && sgraph[5] == 5, "各段载荷内容正确")

    // ---------- 6. 一致性门（确定性拒绝） ----------
    // 非 v3：改版本位为 0x02
    var doc_v2 = zd.slice(doc5, 0, len(doc5))
    doc_v2[8] = 0x02
    var (ok_v2, _, _, _, _) = zd_v3.read_index(doc_v2)
    check(!ok_v2, "非 v3（版本 02）→ 拒绝")
    // bit5 未置位
    var doc_nb5 = zd.slice(doc5, 0, len(doc5))
    doc_nb5[9] = doc_nb5[9] & 0x1F
    var (ok_nb5, _, _, _, _) = zd_v3.read_index(doc_nb5)
    check(!ok_nb5, "bit5 未置位（与 footer 存在不一致）→ 拒绝")
    // crc 篡改
    var doc_crc = zd.slice(doc5, 0, len(doc5))
    var tl = len(doc_crc) - 25
    doc_crc[tl + 24] = (doc_crc[tl + 24] ^ 0xFF) & 0xFF
    var (ok_crc, _, _, _, _) = zd_v3.read_index(doc_crc)
    check(!ok_crc, "footer crc32 篡改 → 拒绝")
    // 无 footer
    var (ok_nf, _, _, _, _) = zd_v3.read_index(mkbytes(50))
    check(!ok_nf, "无 footer → 拒绝")

    // ---------- 8. schema 段（含跨语言 KAT） ----------
    var sn = table_new_i64()
    var ss = table_new_string()
    var st = table_new_i64()
    var sst = table_new_i64()
    table_push(sn, 1); table_push(ss, "id");   table_push(st, 0); table_push(sst, 0)
    table_push(sn, 2); table_push(ss, "name"); table_push(st, 2); table_push(sst, 0)
    check(zd_v3.schema_validate(sn, ss, st, sst), "schema 纪律校验通过")

    // schema_id：tsha1f(n=48, base=48)，48 字符
    var sid = zd_v3.schema_id(sn, ss, st, sst)
    check(str_len(sid) == 48, "schema_id 长度 48（base-48）")

    // **跨语言 KAT**：与 zd-java ZdSchema 的 id 逐字一致
    check(sid == "2dtwvJBb5dojkiHKmKtmpbfhhcseDpLF9141ldgzF8Csdsl0",
        "schema_id == zd-java（跨语言 KAT）")

    // schema 段：字节长度与逐字节 KAT（zd-java encodeSegment hex）
    var sseg = zd_v3.encode_schema(sn, ss, st, sst)
    check(len(sseg) == 114, "schema 段长度 114 == zd-java")
    var kat_hex = "82a26964d93032647477764a426235646f6a6b69484b6d4b746d706266686863736544704c46393134316c64677a4638437364736c30" +
        "a66669656c64739284a36e756d01a46e616d65a26964a2747900a573746174650084a36e756d02a46e616d65a46e616d65a2747902a5737461746500"
    var hexdig: string = "0123456789abcdef"
    var got_hex: string = ""
    var hi: i64 = 0
    while hi < len(sseg) {
        var bb = sseg[hi] & 0xFF
        got_hex = got_hex + str_char(hexdig, bb >> 4) + str_char(hexdig, bb & 0xF)
        hi = hi + 1
    }
    check(got_hex == kat_hex, "schema 段逐字节 == zd-java encodeSegment（跨语言 KAT）")

    // 解码往返（自定界：next == 段长）+ 段内 id 自洽门
    var (sok, sdn, sds, sdt, sdst, snx) = zd_v3.decode_schema(sseg, 0)
    check(sok, "schema 段解码 ok")
    check(snx == len(sseg), "自定界：next == 段长")
    check(len(sdn) == 2 && sds[0] == "id" && sds[1] == "name", "字段名往返")
    check(sdt[1] == 2 && sdst[0] == 0, "类型/状态往返")
    // 篡改 id → 自洽门拒绝
    var sbad = zd.slice(sseg, 0, len(sseg))
    sbad[7] = 0x30
    var (bok, _, _, _, _, _) = zd_v3.decode_schema(sbad, 0)
    check(!bok, "段内 id 被篡改 → 自洽门拒绝")

    // 字段三态纪律
    check(zd_v3.schema_allows_write(zd_v3.schema_state_active()), "active 允许写")
    check(!zd_v3.schema_allows_write(zd_v3.schema_state_deprecated()), "deprecated 禁止新写")
    check(zd_v3.schema_readable(zd_v3.schema_state_active()) &&
          zd_v3.schema_readable(zd_v3.schema_state_deprecated()), "active/deprecated 都可读")
    check(!zd_v3.schema_readable(zd_v3.schema_state_removed()), "removed 不可读")
    // 演进：active → deprecated → removed；跳步拒绝
    var (e1, st1) = zd_v3.schema_evolve(sst, 0, 1)
    check(e1 && st1[0] == 1, "active → deprecated 允许")
    var (e2, st2) = zd_v3.schema_evolve(st1, 0, 2)
    check(e2 && st2[0] == 2, "deprecated → removed 允许")
    var (e3, _) = zd_v3.schema_evolve(sst, 0, 2)
    check(!e3, "active 直接 → removed 拒绝（须经一个版本周期）")
    var (e4, _) = zd_v3.schema_evolve(st2, 0, 1)
    check(!e4, "removed 再 deprecate 拒绝")

    // 纪律拒绝：编号重复 / 非升序 / ty 越界 / state 越界
    var dup = table_new_i64()
    var dups = table_new_string()
    var dupt = table_new_i64()
    var dupst = table_new_i64()
    table_push(dup, 1); table_push(dups, "a"); table_push(dupt, 0); table_push(dupst, 0)
    table_push(dup, 1); table_push(dups, "b"); table_push(dupt, 0); table_push(dupst, 0)
    check(!zd_v3.schema_validate(dup, dups, dupt, dupst), "编号重复 → 拒绝")
    var uns = table_new_i64()
    var unss = table_new_string()
    var unst = table_new_i64()
    var unsst = table_new_i64()
    table_push(uns, 2); table_push(unss, "a"); table_push(unst, 0); table_push(unsst, 0)
    table_push(uns, 1); table_push(unss, "b"); table_push(unst, 0); table_push(unsst, 0)
    check(!zd_v3.schema_validate(uns, unss, unst, unsst), "编号非升序 → 拒绝")
    var bty = table_new_i64()
    var btys = table_new_string()
    var btyt = table_new_i64()
    var btyst = table_new_i64()
    table_push(bty, 1); table_push(btys, "a"); table_push(btyt, 9); table_push(btyst, 0)
    check(!zd_v3.schema_validate(bty, btys, btyt, btyst), "ty 越界(9) → 拒绝")
    var bst = table_new_i64()
    var bsts = table_new_string()
    var bstt = table_new_i64()
    var bstst = table_new_i64()
    table_push(bst, 1); table_push(bsts, "a"); table_push(bstt, 0); table_push(bstst, 3)
    check(!zd_v3.schema_validate(bst, bsts, bstt, bstst), "state 越界(3) → 拒绝")
    // 空 schema（0 字段）合法且 id 稳定
    var en = table_new_i64()
    var es_ = table_new_string()
    var et = table_new_i64()
    var est = table_new_i64()
    var eid1 = zd_v3.schema_id(en, es_, et, est)
    var eid2 = zd_v3.schema_id(en, es_, et, est)
    check(str_len(eid1) == 48 && eid1 == eid2, "空 schema 合法且 id 稳定")

    // ---------- 9. 标准类型三件（ext 固定标记；含跨语言 KAT） ----------
    var hexd2: string = "0123456789abcdef"

    // timestamp（标记 1）：8 字节秒 + 4 字节纳秒
    var ts = zd_v3.encode_timestamp(1700000000, 123456789)
    var ts_hex: string = ""
    var ti: i64 = 0
    while ti < len(ts) {
        var tb = ts[ti] & 0xFF
        ts_hex = ts_hex + str_char(hexd2, tb >> 4) + str_char(hexd2, tb & 0xF)
        ti = ti + 1
    }
    check(ts_hex == "d7010c000000006553f100075bcd15", "timestamp 逐字节 == zd-java（KAT）")
    var (tsok, tssec, tsnano) = zd_v3.decode_timestamp(ts)
    check(tsok && tssec == 1700000000 && tsnano == 123456789, "timestamp 往返")
    check(zd_v3.std_tag_of(ts) == 1, "timestamp 标记 = 1")
    check(len(zd_v3.encode_timestamp(0, 999999999)) > 0, "纳秒上界 999999999 接受")
    check(len(zd_v3.encode_timestamp(0, 1000000000)) == 0, "纳秒越界 1e9 → 拒绝")
    check(len(zd_v3.encode_timestamp(0, 0 - 1)) == 0, "纳秒负值 → 拒绝")

    // decimal（标记 2）：[符号][指数 i8][数字串]
    var dec = zd_v3.encode_decimal(true, 0 - 3, "12345")
    var dec_hex: string = ""
    var di: i64 = 0
    while di < len(dec) {
        var db = dec[di] & 0xFF
        dec_hex = dec_hex + str_char(hexd2, db >> 4) + str_char(hexd2, db & 0xF)
        di = di + 1
    }
    check(dec_hex == "d7020701fd3132333435", "decimal 逐字节 == zd-java（KAT）")
    var (dok, dneg, dexp, ddig) = zd_v3.decode_decimal(dec)
    check(dok && dneg && dexp == 0 - 3 && ddig == "12345", "decimal 往返（负号/指数/数字）")
    check(zd_v3.std_tag_of(dec) == 2, "decimal 标记 = 2")
    check(len(zd_v3.encode_decimal(false, 0, "0")) > 0, "decimal 单字符 0 接受")
    check(len(zd_v3.encode_decimal(false, 0, "12a")) == 0, "decimal 含非数字 → 拒绝")
    check(len(zd_v3.encode_decimal(false, 0, "")) == 0, "decimal 空数字串 → 拒绝")
    check(len(zd_v3.encode_decimal(false, 128, "1")) == 0, "decimal 指数 128 越界 → 拒绝")
    check(len(zd_v3.encode_decimal(false, 0 - 129, "1")) == 0, "decimal 指数 -129 越界 → 拒绝")
    check(len(zd_v3.encode_decimal(false, 127, "1")) > 0, "decimal 指数 +127 接受")

    // uuid（标记 3）：16 字节
    var uu = zd_v3.encode_uuid(0x0102030405060708, 0x1112131415161718)
    var uu_hex: string = ""
    var ui: i64 = 0
    while ui < len(uu) {
        var ub = uu[ui] & 0xFF
        uu_hex = uu_hex + str_char(hexd2, ub >> 4) + str_char(hexd2, ub & 0xF)
        ui = ui + 1
    }
    check(uu_hex == "d7031001020304050607081112131415161718", "uuid 逐字节 == zd-java（KAT）")
    var (uok, umsb, ulsb) = zd_v3.decode_uuid(uu)
    check(uok && umsb == 0x0102030405060708 && ulsb == 0x1112131415161718, "uuid 往返")
    check(zd_v3.std_tag_of(uu) == 3, "uuid 标记 = 3")
    // 标记不符 → 拒绝（用 timestamp 的字节按 uuid 解）
    var (bad_u, _, _) = zd_v3.decode_uuid(ts)
    check(!bad_u, "标记不符（timestamp 按 uuid 解）→ 拒绝")
    // 图容器标记常量
    check(zd_v3.std_tag_graph() == 0x47, "图容器 ext 标记 = 0x47")

    // ---------- 10. 图容器紧凑形态（含跨语言 KAT） ----------
    var hexd3: string = "0123456789abcdef"
    // 用例 1：有向 + varint 索引 id；3 节点；3 边（标签+权重 / 仅权重 / 有向覆盖 false+权重）
    var gn = table_new_i64()
    table_push(gn, 10); table_push(gn, 20); table_push(gn, 30)
    var gns = table_new_string()
    var gf = table_new_i64()
    var gt = table_new_i64()
    var gdp = table_new_i64()
    var gd = table_new_i64()
    var gl = table_new_string()
    var gw = table_new_f64()
    table_push(gf, 0); table_push(gt, 1); table_push(gdp, 0); table_push(gd, 0)
    table_push(gl, "e01"); table_push(gw, 1.5)
    table_push(gf, 1); table_push(gt, 2); table_push(gdp, 0); table_push(gd, 0)
    table_push(gl, ""); table_push(gw, 0.0)
    table_push(gf, 2); table_push(gt, 0); table_push(gdp, 1); table_push(gd, 0)
    table_push(gl, ""); table_push(gw, 2.5)
    var gd1 = zd_v3.graph_encode(true, false, gn, gns, gf, gt, gdp, gd, gl, gw)
    var g1_hex: string = ""
    var gi: i64 = 0
    while gi < len(gd1) {
        var gb = gd1[gi] & 0xFF
        g1_hex = g1_hex + str_char(hexd3, gb >> 4) + str_char(hexd3, gb & 0xF)
        gi = gi + 1
    }
    check(g1_hex == "01030a00001400001e000003000106a36530313ff80000000000000102040000000000000000020005004004000000000000",
        "图容器（有向/索引 id/3 边）逐字节 == zd-java（KAT）")
    var (gok, gdecl, gsid0, gid, gsid, gnn, gne, gpe) = zd_v3.graph_decode_open(gd1, 0)
    check(gok, "图容器 open 解码 ok")
    check(gdecl == 1, "声明：有向、索引 id")
    check(len(gid) == 3 && gid[2] == 30, "节点 id 往返")
    check(gnn == 3 && gne == 3, "节点数 / 边数")
    var e_fr = table_new_i64()
    var e_to = table_new_i64()
    var e_hd = table_new_i64()
    var e_dr = table_new_i64()
    var e_lb = table_new_string()
    var e_wb = table_new_i64()
    var (geok, gnx) = zd_v3.graph_decode_edges(gd1, gpe, gnn, gne, e_fr, e_to, e_hd, e_dr, e_lb, e_wb)
    check(geok, "图容器 edges 解码 ok")
    check(gnx == len(gd1), "图容器自定界：next == 全长")
    check(len(e_fr) == 3 && e_fr[2] == 2 && e_to[2] == 0, "边端点往返")
    check(e_lb[0] == "e01" && bitcast_i64_f64(e_wb[0]) == 1.5, "边标签/权重往返")
    check(e_dr[0] == 2 && e_dr[2] == 0, "有向覆盖往返（无覆盖=2 / false=0）")
    check(e_hd[0] == 6 && e_hd[1] == 4, "边头位（bit1 标签 / bit2 权重）")

    // 用例 2：无向 + string id；2 节点 1 边
    var gn2 = table_new_i64()
    var gns2 = table_new_string()
    table_push(gns2, "alpha"); table_push(gns2, "beta")
    var gf2 = table_new_i64()
    var gt2 = table_new_i64()
    var gdp2 = table_new_i64()
    var gd2v = table_new_i64()
    var gl2 = table_new_string()
    var gw2 = table_new_f64()
    table_push(gf2, 0); table_push(gt2, 1); table_push(gdp2, 0); table_push(gd2v, 0)
    table_push(gl2, "x"); table_push(gw2, 1.0)
    var gd2 = zd_v3.graph_encode(false, true, gn2, gns2, gf2, gt2, gdp2, gd2v, gl2, gw2)
    var g2_hex: string = ""
    var gj: i64 = 0
    while gj < len(gd2) {
        var gb2 = gd2[gj] & 0xFF
        g2_hex = g2_hex + str_char(hexd3, gb2 >> 4) + str_char(hexd3, gb2 & 0xF)
        gj = gj + 1
    }
    check(g2_hex == "0202a5616c7068610000a462657461000001000106a1783ff0000000000000",
        "图容器（无向/string id）逐字节 == zd-java（KAT）")
    var (g2ok, g2decl, g2sidf, _, g2sid, _, _, _) = zd_v3.graph_decode_open(gd2, 0)
    check(g2ok && g2decl == 2 && len(g2sid) == 2 && g2sid[0] == "alpha", "string id 往返")

    // 用例 3：空图（0 节点 0 边）合法
    var egn = table_new_i64()
    var egns = table_new_string()
    var egf = table_new_i64()
    var egt = table_new_i64()
    var egdp = table_new_i64()
    var egd = table_new_i64()
    var egl = table_new_string()
    var egw = table_new_f64()
    var gd3 = zd_v3.graph_encode(true, false, egn, egns, egf, egt, egdp, egd, egl, egw)
    check(len(gd3) == 3 && gd3[0] == 1 && gd3[1] == 0 && gd3[2] == 0, "空图 = 01 00 00（KAT）")
    var (g3ok, _, _, _, _, g3nn, g3ne, g3pe) = zd_v3.graph_decode_open(gd3, 0)
    check(g3ok && g3nn == 0 && g3ne == 0 && g3pe == 3, "空图解码 ok 且自定界")

    // 约束：节点 id 重复 → 拒绝
    var dupn = table_new_i64()
    table_push(dupn, 5); table_push(dupn, 5)
    var dn2 = table_new_string()
    var df2 = table_new_i64()
    var dt2 = table_new_i64()
    var ddp2 = table_new_i64()
    var dd2 = table_new_i64()
    var dl2 = table_new_string()
    var dw2 = table_new_f64()
    check(len(zd_v3.graph_encode(true, false, dupn, dn2, df2, dt2, ddp2, dd2, dl2, dw2)) == 0,
        "节点 id 重复 → 拒绝")
    // 约束：边端点越界 → 拒绝
    var of2 = table_new_i64()
    var ot2 = table_new_i64()
    var odp2 = table_new_i64()
    var od2 = table_new_i64()
    var ol2 = table_new_string()
    var ow2 = table_new_f64()
    table_push(of2, 0); table_push(ot2, 9); table_push(odp2, 0); table_push(od2, 0)
    table_push(ol2, ""); table_push(ow2, 1.0)
    check(len(zd_v3.graph_encode(true, false, gn, gns, of2, ot2, odp2, od2, ol2, ow2)) == 0,
        "边端点越界(9 >= 3 节点) → 拒绝")
    // 约束：解码侧端点越界 → 拒绝（手工构造端点 9 的字节）
    var badg: table<i64> = [1, 3, 10, 0, 0, 20, 0, 0, 30, 0, 0, 1, 0, 9, 4,
        0, 0, 0, 0, 0, 0, 0, 0]
    var (bok2, _, _, _, _, bnn2, bne2, bpe2) = zd_v3.graph_decode_open(badg, 0)
    var bfr2 = table_new_i64()
    var bto2 = table_new_i64()
    var bhd2 = table_new_i64()
    var bdr2 = table_new_i64()
    var blb2 = table_new_string()
    var bwb2 = table_new_i64()
    var (beok2, _) = zd_v3.graph_decode_edges(badg, bpe2, bnn2, bne2, bfr2, bto2, bhd2, bdr2, blb2, bwb2)
    check(bok2 && !beok2, "解码侧端点越界 → 拒绝")
    // 未覆盖面：列式声明位（bit2）→ 确定性拒绝（不静默降级）
    var colg: table<i64> = [5, 0, 0]
    var (cok, _, _, _, _, _, _, _) = zd_v3.graph_decode_open(colg, 0)
    check(!cok, "声明 bit2（列式形态，未覆盖）→ 确定性拒绝")
    // 未覆盖面：节点载荷标志置位 → 拒绝
    var plg: table<i64> = [1, 1, 10, 1, 0, 0, 0]
    var (pok, _, _, _, _, _, _, _) = zd_v3.graph_decode_open(plg, 0)
    check(!pok, "节点载荷标志置位（嵌入形态，未覆盖）→ 确定性拒绝")
    // 自环与多重边合法
    var sfn = table_new_i64()
    var stn = table_new_i64()
    var sdp = table_new_i64()
    var sdv = table_new_i64()
    var sln = table_new_string()
    var swn = table_new_f64()
    table_push(sfn, 0); table_push(stn, 0); table_push(sdp, 0); table_push(sdv, 0)
    table_push(sln, ""); table_push(swn, 1.0)
    table_push(sfn, 0); table_push(stn, 0); table_push(sdp, 0); table_push(sdv, 0)
    table_push(sln, ""); table_push(swn, 2.0)
    var sgl = zd_v3.graph_encode(true, false, gn, gns, sfn, stn, sdp, sdv, sln, swn)
    check(len(sgl) > 0, "自环 + 多重边合法")
    // 图容器 ext 形态（标记 0x47）
    var gext = zd_ext.encode_ext(0x47, gd3)
    check(zd_v3.std_tag_of(gext) == 0x47, "图容器可作 ext 嵌入（标记 0x47）")

    // ---------- 7. 文件往返 ----------
    var path = work + "_v3.zd"
    var body = mkbytes(64)
    check(zd_v3.save_v3(path, body, 0), "save_v3 写文件成功")
    var data = byte_read(path)
    check(len(data) == 10 + 64 + (len(data) - 10 - 64), "读回文件字节数自洽")
    var (lok, lbody) = zd_v3.load_v3(path)
    check(lok, "load_v3 成功")
    check(len(lbody) == 64, "load_v3 数据体长度 64")
    var same: bool = true
    var i: i64 = 0
    while i < 64 {
        if lbody[i] != body[i] {
            same = false
        }
        i = i + 1
    }
    check(same, "load_v3 数据体逐字节一致")

    if fails == 0 {
        println("PASS all")
    } else {
        println("FAIL total=" + to_string(fails))
    }
    println("done")
}
